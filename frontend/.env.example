# URL base do backend (Spring Boot / Authorization Server)
VITE_BACKEND_URL=http://localhost:8080

# Client OAuth2 público (PKCE) — precisa bater com security.client-id do back
VITE_CLIENT_ID=myclientid

# Domínio da SPA (usado no redirect_uri do fluxo OAuth)
VITE_APP_DOMAIN=http://localhost:5173

# redirect_uri registrado no back (security.redirect-uri). Rota /authorized da SPA.
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/authorized

# Scopes solicitados no authorize
VITE_OAUTH_SCOPE=openid profile read write offline_access
