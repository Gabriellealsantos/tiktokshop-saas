	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Nome Completo\",\n  \"email\": \"usuario@example.com\",\n  \"phone\": \"11999999999\",\n  \"cpf\": \"12345678900\",\n  \"password\": \"SenhaForte123\"\n}"
						},
						"url": {
							"raw": "{{host}}/api/auth/register",
							"host": ["{{host}}"],
							"path": ["api", "auth", "register"]
						},
						"description": "Auto-cadastro público. Body: RegisterDTO. Retorna 202 Accepted; usuário nasce PENDING_CONFIRMATION."
					}
				},
				{
					"name": "Confirm Email",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{host}}/api/auth/confirm?token={{confirmToken}}",
							"host": ["{{host}}"],
							"path": ["api", "auth", "confirm"],
							"query": [{ "key": "token", "value": "{{confirmToken}}" }]
						},
						"description": "Confirma o e-mail via token recebido por e-mail no Register. Retorna 204 No Content."
					}
				},
				{
					"name": "Recover Token",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"usuario@example.com\"\n}"
						},
						"url": {
							"raw": "{{host}}/auth/recover-token",
							"host": ["{{host}}"],
							"path": ["auth", "recover-token"]
						},
						"description": "Gera e envia por e-mail um token de recuperação de senha. Body: EmailDTO. Retorna 204 No Content."
					}
				},
				{
					"name": "New Password",
					"request": {
						"auth": { "type": "noauth" },
						"method": "PUT",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"{{recoverToken}}\",\n  \"password\": \"NovaSenhaForte123\"\n}"
						},
						"url": {
							"raw": "{{host}}/auth/new-password",
							"host": ["{{host}}"],
							"path": ["auth", "new-password"]
						},
						"description": "Define nova senha usando o token gerado em Recover Token. Body: NewPasswordDTO. Retorna 204 No Content."
					}
				}
			]
		},
