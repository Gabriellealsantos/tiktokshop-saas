						"url": {
							"raw": "{{host}}/users",
							"host": ["{{host}}"],
							"path": ["users"]
						},
						"description": "Cria um usuário. Body: UserInsertDTO. Requer ADMIN ou SUPER_ADMIN. Retorna 201 + Location header."
					}
				},
				{
					"name": "Update user",
					"request": {
						"method": "PUT",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Nome Atualizado\",\n  \"phoneNumber\": \"11988888888\",\n  \"cpf\": \"12345678900\",\n  \"email\": \"usuario@example.com\",\n  \"birthDate\": \"1995-05-20T00:00:00Z\",\n  \"userStatus\": \"ACTIVE\",\n  \"roles\": [\n    { \"id\": 1, \"authority\": \"ROLE_USER\" }\n  ]\n}"
						},
						"url": {
							"raw": "{{host}}/users/{{userId}}",
							"host": ["{{host}}"],
							"path": ["users", "{{userId}}"]
						},
						"description": "Atualiza um usuário existente. Body: UserUpdateDTO (password opcional). Requer ADMIN ou SUPER_ADMIN."
					}
				},
				{
					"name": "Delete user",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{host}}/users/{{userId}}",
							"host": ["{{host}}"],
							"path": ["users", "{{userId}}"]
						},
						"description": "Remove (soft delete) um usuário. Requer ADMIN ou SUPER_ADMIN. Retorna 204 No Content."
					}
				}
			]
		},
